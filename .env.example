# ── Usuarios (solo 2, sin registro) ─────────────────────────
USER1_NAME=Tomás
USER1_PASS=cambia-esta-clave
USER2_NAME=Valeria
USER2_PASS=cambia-esta-otra

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ── Base de datos (Neon Postgres vía Vercel Marketplace) ────
# Si se deja vacía en desarrollo, se usa una base local PGlite en ./.pglite
DATABASE_URL=

# ── Imágenes (Vercel Blob) ──────────────────────────────────
# Si se deja vacía en desarrollo, las imágenes se guardan en ./public/uploads
BLOB_READ_WRITE_TOKEN=
